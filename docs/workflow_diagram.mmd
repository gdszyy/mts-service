graph TD
    A[人类监督者: 定义任务] --> B(管理者 Agent: 初始化任务);
    B --> B1{创建 Git 分支和任务目录};
    B1 --> B2[生成任务说明书 README.md];
    B2 --> C(管理者 Agent: 分派任务);
    C --> D(执行者 Agent: 接收并执行任务);
    D --> D1[读取 README.md];
    D1 --> D2{编码、测试、记录日志};
    D2 --> D3[生成交付报告 report.md];
    D3 --> E{提交代码并创建 Pull Request};
    E -- Webhook通知 --> F(管理者 Agent: 审查 PR);
    F --> F1[自动化代码与文档审查];
    F1 --> F2{生成审查报告};
    F2 --> G{决策：通过?};
    G -- 否 --> H(管理者 Agent: 要求修改);
    H --> D;
    G -- 是 --> I(管理者 Agent: 批准并合并);
    I --> I1[合并 PR 到 main 分支];
    I1 --> I2[清理特性分支];
    I2 --> J[更新项目管理工具状态];
    J --> K[任务完成];

    subgraph 任务初始化
        B; B1; B2;
    end

    subgraph 任务执行
        D; D1; D2; D3; E;
    end

    subgraph 任务验收
        F; F1; F2; G; H; I; I1; I2; J;
    end
